<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/eq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_eq"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_window"
        app:title="Auralis"
        app:titleTextColor="@color/text_primary"
        app:menu="@menu/eq_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="72dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_eq"
        app:layout_constraintBottom_toTopOf="@id/mini_player_eq"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Master Equalizer & DSP Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/surface_card"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_eq_master"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_equalizer_24"
                    app:tint="@color/accent_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icon_eq_master"
                    app:layout_constraintEnd_toStartOf="@id/switch_eq_master">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Equalizer &amp; DSP"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="● Engine Active • 32-bit Float Processing"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_eq_master"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/on_accent_blue"
                    app:trackTint="@color/accent_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Headphone Calibration Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/surface_card"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/icon_headphone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_headphones_24"
                    app:tint="@color/accent_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icon_headphone"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sony WH-1000XM5"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Parametric Target Curve Applied"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Tuning Profiles Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flat"
                        app:chipBackgroundColor="@color/surface_card"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bass Boost"
                        app:chipBackgroundColor="@color/surface_card"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rock"
                        app:chipBackgroundColor="@color/surface_card"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="⚡ Electronic"
                        app:chipBackgroundColor="@color/accent_blue"
                        android:textColor="@color/on_accent_blue" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 5-Band Graphic EQ Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/surface_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_eq_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5-Band Precision Graphic EQ"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/btn_zero_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zero Reset"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/text_eq_header"
                    app:layout_constraintBottom_toBottomOf="@id/text_eq_header"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Sliders Row: 60Hz, 230Hz, 910Hz, 3.6kHz, 14kHz -->
                <LinearLayout
                    android:id="@+id/layout_sliders_row"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="5"
                    app:layout_constraintTop_toBottomOf="@id/text_eq_header"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Band 1: 60Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+4dB"
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp" />
                        <SeekBar
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:rotation="270"
                            android:layout_marginTop="40dp"
                            android:layout_marginBottom="40dp"
                            android:progress="70"
                            android:progressTint="@color/accent_blue"
                            android:thumbTint="@color/accent_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60Hz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Band 2: 230Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+2dB"
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp" />
                        <SeekBar
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:rotation="270"
                            android:layout_marginTop="40dp"
                            android:layout_marginBottom="40dp"
                            android:progress="60"
                            android:progressTint="@color/accent_blue"
                            android:thumbTint="@color/accent_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="230Hz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Band 3: 910Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0dB"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <SeekBar
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:rotation="270"
                            android:layout_marginTop="40dp"
                            android:layout_marginBottom="40dp"
                            android:progress="50"
                            android:progressTint="@color/accent_blue"
                            android:thumbTint="@color/accent_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="910Hz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Band 4: 3.6kHz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+3dB"
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp" />
                        <SeekBar
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:rotation="270"
                            android:layout_marginTop="40dp"
                            android:layout_marginBottom="40dp"
                            android:progress="65"
                            android:progressTint="@color/accent_blue"
                            android:thumbTint="@color/accent_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3.6k"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Band 5: 14kHz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+5dB"
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp" />
                        <SeekBar
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:rotation="270"
                            android:layout_marginTop="40dp"
                            android:layout_marginBottom="40dp"
                            android:progress="75"
                            android:progressTint="@color/accent_blue"
                            android:thumbTint="@color/accent_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14kHz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Dual DSP Dials (Bass Boost & Virtualizer) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Bass Boost Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@color/surface_card"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/text_bass_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bass Boost"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="65%"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ProgressBar
                        android:id="@+id/circular_bass"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:max="100"
                        android:progress="65"
                        android:progressDrawable="@drawable/bg_circular_progress"
                        app:layout_constraintTop_toBottomOf="@id/text_bass_title"
                        app:layout_constraintBottom_toTopOf="@id/text_bass_sub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/text_bass_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harmonic Sub-Octave"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Virtualizer Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@color/surface_card"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/text_virt_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Virtualizer"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40%"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ProgressBar
                        android:id="@+id/circular_virt"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:max="100"
                        android:progress="40"
                        android:progressDrawable="@drawable/bg_circular_progress"
                        app:layout_constraintTop_toBottomOf="@id/text_virt_title"
                        app:layout_constraintBottom_toTopOf="@id/text_virt_sub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/text_virt_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crossfeed Binaural"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Mini Player -->
    <include
        android:id="@+id/mini_player_eq"
        layout="@layout/layout_mini_player"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_eq"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_eq"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/bg_window"
        app:itemIconTint="@color/selector_nav_tint"
        app:itemTextColor="@color/selector_nav_tint"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>