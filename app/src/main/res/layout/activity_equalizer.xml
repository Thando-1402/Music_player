<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/eq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_eq"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_window"
        app:title="DSP Equalizer"
        app:titleTextColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/switch_eq_master" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_eq_master"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:checked="true"
        app:thumbTint="@color/on_accent_blue"
        app:trackTint="@color/accent_blue"
        app:layout_constraintTop_toTopOf="@id/toolbar_eq"
        app:layout_constraintBottom_toBottomOf="@id/toolbar_eq"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_eq"
        app:layout_constraintBottom_toTopOf="@id/mini_player_eq"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <!-- Preset Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_preset_flat"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flat Reference"
                        android:checked="true"
                        app:chipBackgroundColor="@color/surface_container_high"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_preset_bass"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Bass &amp; Sub"
                        app:chipBackgroundColor="@color/surface_container_high"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_preset_vocal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Vocal Clarity"
                        app:chipBackgroundColor="@color/surface_container_high"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_preset_harman"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Harman Target"
                        app:chipBackgroundColor="@color/surface_container_high"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- AI Auto-EQ Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_auto_eq"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="12dp"
                android:text="✨ AI Smart-Tune EQ for Current Track"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                app:icon="@drawable/ic_auto_awesome_24"
                app:iconTint="@color/accent_blue"
                app:iconSize="15dp"
                app:backgroundTint="@color/surface_card"
                app:cornerRadius="10dp" />

            <!-- 5-Band Parametric Sliders Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_card_12dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_eq_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5-BAND HARDWARE DSP • ±15 dB"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <!-- Band 1: 60 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/label_band_0"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="60 Hz"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seek_band_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="3000"
                        android:progress="1500"
                        android:progressTint="@color/accent_blue"
                        android:thumbTint="@color/accent_blue" />
                    <TextView
                        android:id="@+id/val_band_0"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0.0 dB"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Band 2: 230 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/label_band_1"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="230 Hz"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seek_band_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="3000"
                        android:progress="1500"
                        android:progressTint="@color/accent_blue"
                        android:thumbTint="@color/accent_blue" />
                    <TextView
                        android:id="@+id/val_band_1"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0.0 dB"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Band 3: 910 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/label_band_2"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="910 Hz"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seek_band_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="3000"
                        android:progress="1500"
                        android:progressTint="@color/accent_blue"
                        android:thumbTint="@color/accent_blue" />
                    <TextView
                        android:id="@+id/val_band_2"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0.0 dB"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Band 4: 3.6 kHz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/label_band_3"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="3.6 kHz"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seek_band_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="3000"
                        android:progress="1500"
                        android:progressTint="@color/accent_blue"
                        android:thumbTint="@color/accent_blue" />
                    <TextView
                        android:id="@+id/val_band_3"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0.0 dB"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Band 5: 14 kHz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/label_band_4"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="14 kHz"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seek_band_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="3000"
                        android:progress="1500"
                        android:progressTint="@color/accent_blue"
                        android:thumbTint="@color/accent_blue" />
                    <TextView
                        android:id="@+id/val_band_4"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0.0 dB"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hardware Bass Boost & Spatial Virtualizer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_card_12dp"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANALOG BASS &amp; SPATIAL STAGE"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:text="Sub Bass"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seek_bass_boost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="250"
                        android:progressTint="@color/accent_blue"
                        android:thumbTint="@color/accent_blue" />
                    <TextView
                        android:id="@+id/val_bass_boost"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:text="25%"
                        android:textColor="@color/accent_blue"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:text="Soundstage"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seek_virtualizer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="150"
                        android:progressTint="@color/accent_blue"
                        android:thumbTint="@color/accent_blue" />
                    <TextView
                        android:id="@+id/val_virtualizer"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:text="15%"
                        android:textColor="@color/accent_blue"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/mini_player_eq"
        layout="@layout/layout_mini_player"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_eq"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_eq"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/bg_window"
        app:itemIconTint="@color/selector_nav_tint"
        app:itemTextColor="@color/selector_nav_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>