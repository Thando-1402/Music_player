<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_edit_track_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold" />

    <TextView
        android:id="@+id/text_storage_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dialog_saving_target"
        android:textColor="@color/accent_blue"
        android:textSize="12sp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_edit_cover_preview"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/cd_album_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_album_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pick_cover"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/btn_change_album_cover"
        android:textColor="@color/accent_blue"
        android:textSize="12sp"
        app:strokeColor="@color/divider_line" />

    <EditText
        android:id="@+id/edit_song_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:autofillHints=""
        android:hint="@string/hint_track_title"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/edit_song_artist"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:autofillHints=""
        android:hint="@string/hint_artist_name"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:inputType="textCapWords" />

</LinearLayout>
