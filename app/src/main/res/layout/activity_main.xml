<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_main"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_window"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="@color/text_primary"
        app:menu="@menu/main_library_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_view_library"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_rounded_card_12dp"
        android:visibility="gone"
        app:iconifiedByDefault="false"
        app:queryHint="@string/search_library_hint"
        app:searchIcon="@drawable/ic_search_24"
        app:closeIcon="@drawable/ic_close_24"
        app:layout_constraintTop_toBottomOf="@id/toolbar_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/chip_scroll_container"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/search_view_library"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all_songs"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_all_tracks"
                android:checked="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/surface_container_high"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_ai_smart_mix"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_ai_smart_mix"
                app:chipIcon="@drawable/ic_auto_awesome_24"
                app:chipIconTint="@color/accent_blue"
                app:chipIconSize="15dp"
                app:chipBackgroundColor="@color/surface_card"
                android:textColor="@color/accent_blue" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_artists"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_by_artist"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/surface_container_high"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_folders"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_storage_folders"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/surface_container_high"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_albums"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chip_playlists"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/surface_container_high"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_list_meta"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/chip_scroll_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_library_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/scanning_local_library"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_shuffle_all_library" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_shuffle_all_library"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_shuffle"
            android:textSize="11sp"
            android:textColor="@color/accent_blue"
            app:icon="@drawable/ic_shuffle_24"
            app:iconTint="@color/accent_blue"
            app:iconSize="14dp"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="17dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_songs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbarThumbVertical="@drawable/fast_scroll_thumb"
        android:scrollbarSize="4dp"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_song"
        app:layout_constraintTop_toBottomOf="@id/header_list_meta"
        app:layout_constraintBottom_toTopOf="@id/mini_player_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/empty_state_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toTopOf="@id/recycler_view_songs"
        app:layout_constraintBottom_toBottomOf="@id/recycler_view_songs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/cd_empty_library_icon"
            android:src="@drawable/ic_music_note_24"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/empty_library_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>

    <include
        android:id="@+id/mini_player_main"
        layout="@layout/layout_mini_player"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/bg_window"
        app:itemIconTint="@color/selector_nav_tint"
        app:itemTextColor="@color/selector_nav_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
