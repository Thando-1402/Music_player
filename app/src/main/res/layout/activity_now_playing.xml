<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Header Toolbar -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_collapse"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_keyboard_arrow_down_24"
        app:tint="#FFFFFF"
        android:contentDescription="Minimize player"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text_now_playing_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOW PLAYING"
        android:textColor="#B0B3B8"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="@id/btn_collapse"
        app:layout_constraintBottom_toBottomOf="@id/btn_collapse"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_queue"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_queue_music_24"
        app:tint="#FFFFFF"
        android:contentDescription="Play queue"
        app:layout_constraintTop_toTopOf="@id/btn_collapse"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1:1 Aspect Ratio Hero Album Art -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/hero_album_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_album_placeholder_large"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded16dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/btn_collapse"
        app:layout_constraintBottom_toTopOf="@id/metadata_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Metadata Block -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/metadata_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/seek_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_favorite">

            <TextView
                android:id="@+id/np_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Starlight Memories"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/np_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lunar Collective • Odyssey"
                android:textColor="#B0B3B8"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_favorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border_24"
            app:tint="#B0B3B8"
            android:contentDescription="Favorite Track"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Seek Bar Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/seek_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/primary_controls_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/track_seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="#2C2C2C"
            android:progressTint="#00E676"
            android:thumbTint="#00E676"
            android:max="100"
            android:progress="35"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_elapsed_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1:18"
            android:textColor="#B0B3B8"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:layout_constraintTop_toBottomOf="@id/track_seek_bar"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_remaining_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="-2:27"
            android:textColor="#B0B3B8"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:layout_constraintTop_toBottomOf="@id/track_seek_bar"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Primary Controls (Prev, Hero FAB, Next) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/primary_controls_layout"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/secondary_controls_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_previous"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_previous_32"
            app:tint="#FFFFFF"
            android:contentDescription="Previous track"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_play_pause_hero"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_play_pause_hero"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:backgroundTint="#00E676"
            app:fabCustomSize="72dp"
            app:maxImageSize="36dp"
            android:src="@drawable/ic_play_arrow_36"
            app:tint="#003314"
            app:elevation="4dp"
            android:contentDescription="Play or Pause"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_previous"
            app:layout_constraintEnd_toStartOf="@id/btn_next" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_next"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next_32"
            app:tint="#FFFFFF"
            android:contentDescription="Next track"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_play_pause_hero"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Secondary Controls -->
    <LinearLayout
        android:id="@+id/secondary_controls_layout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shuffle_24"
            app:tint="#757575"
            android:contentDescription="Shuffle" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_lyrics_toggle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="LYRICS"
            android:textSize="11sp"
            android:textColor="#B0B3B8"
            app:strokeColor="#2C2C2C"
            app:cornerRadius="18dp"
            android:paddingHorizontal="16dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_repeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_repeat_24"
            app:tint="#757575"
            android:contentDescription="Repeat" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>