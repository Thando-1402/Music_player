<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_now_playing_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window"
    android:fitsSystemWindows="true">

    <!-- Full-Screen Immersive Backdrop Art -->
    <ImageView
        android:id="@+id/iv_fullscreen_backdrop_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.35"
        android:src="@drawable/ic_album_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_scrim_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="460dp"
        android:background="@drawable/bg_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_collapse"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        app:icon="@drawable/ic_keyboard_arrow_down_24"
        app:iconSize="28dp"
        app:iconTint="@color/text_primary"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="NOW PLAYING"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_collapse"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toTopOf="@id/btn_collapse" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_queue"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:icon="@drawable/ic_queue_music_24"
        app:iconSize="22dp"
        app:iconTint="@color/text_primary"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toTopOf="@id/btn_collapse"
        app:layout_constraintBottom_toBottomOf="@id/btn_collapse" />

    <!-- 1:1 Square Hero Artwork Card (Never Squashed) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_hero_album_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_album_placeholder_large"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_max="250dp"
        app:layout_constraintTop_toBottomOf="@id/btn_collapse"
        app:layout_constraintBottom_toTopOf="@id/lyrics_live_card"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_lossless_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_rounded_card_12dp"
        android:drawableStart="@drawable/ic_equalizer_24"
        android:drawablePadding="4dp"
        android:drawableTint="@color/accent_blue"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="Hi-Res Lossless"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_hero_album_art"
        app:layout_constraintStart_toStartOf="@id/iv_hero_album_art" />

    <!-- Live Auto-Scrolling Synchronized Lyrics Banner -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/lyrics_live_card"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_rounded_card_12dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/tv_track_title"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_lyric_active_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="♪ Tap LYRICS below to view or load .lrc lyrics"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_lyric_next_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Full-Screen Expandable Lyrics Overlay (Toggled by LYRICS button) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/lyrics_scroll_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E6121316"
        android:padding="18dp"
        android:visibility="gone"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="@id/iv_hero_album_art"
        app:layout_constraintBottom_toBottomOf="@id/iv_hero_album_art"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end">

        <TextView
            android:id="@+id/tv_scrolled_lyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="6dp"
            android:text="No lyrics loaded."
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_track_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:text="Select a track"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tv_track_artist_album"
        app:layout_constraintEnd_toStartOf="@id/btn_toggle_favorite"
        app:layout_constraintStart_toStartOf="@id/guideline_start" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_track_artist_album"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Auralis Hi-Res Audio"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/slider_playback_progress"
        app:layout_constraintEnd_toStartOf="@id/btn_toggle_favorite"
        app:layout_constraintStart_toStartOf="@id/guideline_start" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_favorite"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:icon="@drawable/ic_favorite_border_24"
        app:iconSize="24dp"
        app:iconTint="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="@id/tv_track_artist_album"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toTopOf="@id/tv_track_title" />

    <SeekBar
        android:id="@+id/slider_playback_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:max="1000"
        android:progressTint="@color/accent_blue"
        android:thumbTint="@color/accent_blue"
        app:layout_constraintBottom_toTopOf="@id/tv_time_current"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintStart_toStartOf="@id/guideline_start" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_time_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="monospace"
        android:text="0:00"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/btn_play_pause_fab"
        app:layout_constraintStart_toStartOf="@id/guideline_start" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_time_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:fontFamily="monospace"
        android:text="-0:00"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_time_current"
        app:layout_constraintEnd_toEndOf="@id/guideline_end" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip_previous"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:icon="@drawable/ic_skip_previous_24"
        app:iconSize="30dp"
        app:iconTint="@color/text_primary"
        app:layout_constraintBottom_toBottomOf="@id/btn_play_pause_fab"
        app:layout_constraintEnd_toStartOf="@id/btn_play_pause_fab"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toTopOf="@id/btn_play_pause_fab" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_play_pause_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:backgroundTint="@color/accent_blue"
        app:elevation="4dp"
        app:fabCustomSize="64dp"
        app:layout_constraintBottom_toTopOf="@id/btn_lyrics_sheet"
        app:layout_constraintEnd_toStartOf="@id/btn_skip_next"
        app:layout_constraintStart_toEndOf="@id/btn_skip_previous"
        app:maxImageSize="32dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:srcCompat="@drawable/ic_pause_24"
        app:tint="@color/bg_window" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip_next"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:icon="@drawable/ic_skip_next_24"
        app:iconSize="30dp"
        app:iconTint="@color/text_primary"
        app:layout_constraintBottom_toBottomOf="@id/btn_play_pause_fab"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintStart_toEndOf="@id/btn_play_pause_fab"
        app:layout_constraintTop_toTopOf="@id/btn_play_pause_fab" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_shuffle"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:icon="@drawable/ic_shuffle_24"
        app:iconSize="22dp"
        app:iconTint="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="@id/btn_lyrics_sheet"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toTopOf="@id/btn_lyrics_sheet" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lyrics_sheet"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/surface_card"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:text="LYRICS"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        app:cornerRadius="17dp"
        app:icon="@drawable/ic_library_music_24"
        app:iconSize="16dp"
        app:iconTint="@color/accent_blue"
        app:layout_constraintBottom_toTopOf="@id/card_audio_route_output"
        app:layout_constraintEnd_toStartOf="@id/btn_toggle_repeat"
        app:layout_constraintStart_toEndOf="@id/btn_toggle_shuffle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_repeat"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:icon="@drawable/ic_repeat_24"
        app:iconSize="22dp"
        app:iconTint="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="@id/btn_lyrics_sheet"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toTopOf="@id/btn_lyrics_sheet" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_audio_route_output"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#CC1E1F22"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:strokeColor="#26FFFFFF"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/iv_route_type_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_headphones_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/accent_blue" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_connected_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Internal Hi-Fi Speaker DAC"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:layout_constraintBottom_toTopOf="@id/tv_connected_device_codec"
                app:layout_constraintEnd_toStartOf="@id/btn_switch_audio_route"
                app:layout_constraintStart_toEndOf="@id/iv_route_type_icon"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_connected_device_codec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="24-BIT PCM • SPEAKER"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_switch_audio_route"
                app:layout_constraintStart_toEndOf="@id/iv_route_type_icon"
                app:layout_constraintTop_toBottomOf="@id/tv_connected_device_name" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_switch_audio_route"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:icon="@drawable/ic_sync_24"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
